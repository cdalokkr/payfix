modules = ["nodejs-24", "python-base-3.13"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[deployment]
deploymentTarget = "autoscale"
# pnpm is the repository's canonical package manager; see package.json.
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "start"]

[nix]
channel = "stable-25_05"
