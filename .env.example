# ============================================
# Environment Variables Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file containing actual secrets
# ============================================

# ============================================
# Supabase Configuration
# ============================================

# Public Supabase URL - Safe to expose to client
# Get this from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key - Safe to expose to client
# This key has limited permissions based on RLS policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key - NEVER expose to client
# This key bypasses RLS and should only be used server-side
# Keep this secret and never commit it to version control
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Application Configuration
# ============================================

# Node environment (development, production, test)
NODE_ENV=development

# Application URL (used for redirects and CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Security Configuration (Optional)
# ============================================

# Rate limiting configuration (optional - defaults are set in middleware)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# Session configuration (optional)
# SESSION_SECRET=your-session-secret-here

# ============================================
# Feature Flags (Optional)
# ============================================

# Enable/disable features
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_DEBUG_MODE=false

# ============================================
# Biometric Device Integration (Optional)
# ============================================

# API key for authenticating biometric device sync agents.
# Set this to a strong, random string. The local sync agent
# will use this as a Bearer token when pushing punch logs
# to POST /api/biometric/sync
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BIOMETRIC_SYNC_API_KEY=your-biometric-sync-api-key-here

# ============================================
# Third-party Services (Optional)
# ============================================

# Error tracking (e.g., Sentry)
# SENTRY_DSN=your-sentry-dsn-here

# Analytics (e.g., Google Analytics)
# NEXT_PUBLIC_GA_TRACKING_ID=your-ga-id-here

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================
# 
# 1. NEVER commit actual secrets to version control
# 2. Use NEXT_PUBLIC_ prefix ONLY for values safe to expose to browsers
# 3. Service role keys should NEVER have NEXT_PUBLIC_ prefix
# 4. Rotate secrets regularly, especially after any potential exposure
# 5. Use different credentials for development, staging, and production
# 6. Consider using a secrets manager for production deployments
#