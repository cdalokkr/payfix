{
  "compilerOptions": {
    // Target ES2024 for modern JavaScript features (TypeScript 6 compatible)
    "target": "ES2024",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    // TypeScript 6: explicitly list required @types packages (default is now [])
    "types": ["node", "jest", "react"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // React 19 JSX transform
    "jsx": "react-jsx",
    "incremental": true,
    // Ensure consistent casing in imports
    "forceConsistentCasingInFileNames": true,
    // Next.js plugin for enhanced type checking
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Path aliases
    "paths": {
      "@/*": [
        "./*"
      ],
      "drizzle-orm": [
        "./node_modules/drizzle-orm"
      ],
      "drizzle-orm/*": [
        "./node_modules/drizzle-orm/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions"
  ]
}